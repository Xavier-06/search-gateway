# Search Gateway 环境变量配置
# 复制为 .env 并填写实际值

# SearXNG URL（默认本地 Docker）
SEARXNG_URL=http://127.0.0.1:8888

# 代理地址（国内需要，海外可选）
# 格式: http://127.0.0.1:7897 或 socks5://127.0.0.1:1080
PROXY_URL=http://127.0.0.1:7897

# DDG CLI 路径（可选，默认 ddgs）
# DDGS_BIN=/usr/local/bin/ddgs

# SearXNG 端口
# SEARXNG_PORT=8888
